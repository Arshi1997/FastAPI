## 7. Key code

### `main.py` (additions at the bottom, after all routes)

```python
from agno.os import AgentOS
from agents import ops_agent, docs_agent

agent_os = AgentOS(
    agents=[ops_agent, docs_agent],
    base_app=app,
    on_route_conflict="preserve_base_app",   # keep our own GET /
    tracing=True,
)
app = agent_os.get_app()
```

### `agents.py`

```python
from agno.agent import Agent
from agno.db.sqlite import SqliteDb
from agno.models.ollama import Ollama
from agno.tools.mcp import MCPTools

db = SqliteDb(db_file="agno.db")      # one shared store for both agents

ops_agent = Agent(
    id="ops-agent",
    name="Ops Agent",
    model=Ollama(id="llama3.1:8b"),
    db=db,
    tools=[MCPTools(transport="streamable-http", url="http://localhost:9000/mcp")],
    add_history_to_context=True,
    debug_mode=True,
)

docs_agent = Agent(
    id="docs-agent",
    name="Microsoft Docs Agent",
    model=Ollama(id="llama3.1:8b"),
    db=db,
    tools=[MCPTools(transport="streamable-http", url="https://learn.microsoft.com/api/mcp")],
    instructions=["Answer Microsoft and Azure questions by searching the docs tools first, and list the page URLs you used."],
    add_history_to_context=True,
)
```

### `mcp_server.py`

```python
from mcp.server.fastmcp import FastMCP
from database import SessionLocal
import database_models

mcp = FastMCP("users-tools", port=9000)

def _row(u) -> dict:
    return {"id": u.id, "name": u.name, "age": u.age, "std": u.std,
            "gender": u.gender, "email": u.email}

@mcp.tool()
def get_users(std: str | None = None) -> list[dict]:
    """List users from the database, optionally filtered by class, e.g. '10th'."""
    db = SessionLocal()
    try:
        q = db.query(database_models.User)
        if std:
            q = q.filter(database_models.User.std == std)
        return [_row(u) for u in q.all()]
    finally:
        db.close()

@mcp.tool()
def get_user_by_id(user_id: int) -> dict:
    """Get a single user by id. Returns an error message if not found."""
    db = SessionLocal()
    try:
        u = db.query(database_models.User).filter(database_models.User.id == user_id).first()
        return _row(u) if u else {"error": f"No user with id {user_id}"}
    finally:
        db.close()

if __name__ == "__main__":
    mcp.run(transport="streamable-http")   # http://localhost:9000/mcp
```

### `agent_loop.py`

```python
import json
from openai import OpenAI              # client library only; talks to Ollama, not to OpenAI
from database import SessionLocal
import database_models

client = OpenAI(api_key="ollama", base_url="http://localhost:11434/v1")   # key ignored but required
MODEL = "llama3.1:8b"

def get_users(std: str | None = None) -> list[dict]:
    db = SessionLocal()
    try:
        q = db.query(database_models.User)
        if std:
            q = q.filter(database_models.User.std == std)
        return [{"id": u.id, "name": u.name, "age": u.age,
                 "std": u.std, "gender": u.gender} for u in q.all()]
    finally:
        db.close()

TOOLS = {"get_users": get_users}
TOOL_SPECS = [{
    "type": "function",
    "function": {
        "name": "get_users",
        "description": "List users from the database, optionally filtered by class, e.g. '10th'.",
        "parameters": {"type": "object", "properties": {"std": {"type": "string"}}},
    },
}]

def run_agent(question: str, temperature: float = 0.2) -> str:
    messages = [{"role": "user", "content": question}]
    for _ in range(5):                       # loop cap
        r = client.chat.completions.create(model=MODEL, messages=messages,
                                           tools=TOOL_SPECS, temperature=temperature)
        msg = r.choices[0].message
        messages.append(msg.model_dump(exclude_none=True))
        if not msg.tool_calls:               # no tool requested: model is done
            return msg.content
        for call in msg.tool_calls:
            args = json.loads(call.function.arguments or "{}")
            print("tool call:", call.function.name, args)
            out = TOOLS[call.function.name](**args)
            messages.append({"role": "tool", "tool_call_id": call.id,
                             "content": json.dumps(out)})
    return "Stopped: too many tool calls"
```

The route in `main.py`:

```python
class ChatRequest(BaseModel):
    message: str

@app.post("/api/chat/agent")
def chat_agent(req: ChatRequest):
    return {"reply": run_agent(req.message)}
```

---

## 8. Endpoints

**Own routes:** `GET /`, `GET/POST /api/users`, `GET/PUT/DELETE /api/users/{id}`, `GET /api/stats`, `POST /api/chat/agent`.

**Added by AgentOS** (you did not write these):

| Group | Examples | Use |
|---|---|---|
| Agents | `GET /agents`, `POST /agents/{agent_id}/runs` | List agents, run one. The runs endpoint is what a React frontend would call |
| Sessions | `/sessions...` | Stored conversations |
| Traces | `/traces...` | Recorded steps of each run: model calls, tool calls, timing |
| Metrics, Health, Core | `/metrics`, `/health`, `/info`, `/config` | Usage, liveness, loaded config |
| Memory, Knowledge, Evals, Learnings | `/memories`, `/knowledge/...`, `/eval-runs` | Optional Agno features, unused so far |
| Teams, Workflows | `/teams`, `/workflows` | Multi-agent and pipelines, none defined |
| Queue, Components, Schedules, Approvals, Service Accounts | marked Disabled | Need a database passed to `AgentOS` itself |

A `WebSocket /workflows/ws` connection in the log is the AgentOS UI opening a live-progress channel. It is harmless. WebSocket routes do not appear on `/docs`.

